# Copy to .env.local and fill in. NEVER commit the real .env file.

# --- Database ---
# Postgres in production (Neon/Supabase). SQLite is used for local dev/CI by default
# via the schema's provider; switch to postgres before handling real PII.
DATABASE_URL="postgresql://user:password@localhost:5432/padawan?schema=public"

# --- Auth.js ---
# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-me-with-a-long-random-string"
# Base URL of the app (required by Auth.js in production)
AUTH_URL="http://localhost:3000"

# --- PII field encryption ---
# 32-byte key, base64-encoded. Generate with: openssl rand -base64 32
# Rotating this key requires re-encrypting existing PII. In production this should
# come from a KMS / secret manager, never a committed file.
PII_ENCRYPTION_KEY="replace-me-with-a-32-byte-base64-key"

# --- HubSpot (CRM sync) — optional, added in Phase 2 ---
HUBSPOT_ACCESS_TOKEN=""
