{
  "name": "padawan",
  "version": "0.1.0",
  "private": true,
  "description": "Padawan — secure insurance broker platform (risk data + client database foundation)",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
